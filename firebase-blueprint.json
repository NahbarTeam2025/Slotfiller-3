{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "A local service provider.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "googleUid": { "type": "string" },
        "openTime": { "type": "string" },
        "closeTime": { "type": "string" },
        "serviceTypes": { "type": "array", "items": { "type": "string" } },
        "smsBalance": { "type": "number" },
        "twilioSid": { "type": "string" },
        "twilioToken": { "type": "string" },
        "twilioPhone": { "type": "string" },
        "smsTemplate": { "type": "string" },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "color": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "googleUid", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "description": "A client of the business.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "serviceTypes": { "type": "array", "items": { "type": "string" } },
        "preferredTimes": { "type": "array", "items": { "type": "string" } },
        "consentGiven": { "type": "boolean" },
        "consentTimestamp": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "consentGiven", "consentTimestamp", "active", "createdAt"]
    },
    "Slot": {
      "title": "Slot",
      "description": "An available appointment slot.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "time": { "type": "string" },
        "serviceType": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "booked", "expired"] },
        "notifiedClients": { "type": "array", "items": { "type": "string" } },
        "bookedBy": { "type": "string" },
        "bookedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "time", "serviceType", "status", "createdAt"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Stores business profiles."
    },
    "/businesses/{businessId}/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Stores clients for a specific business."
    },
    "/businesses/{businessId}/slots/{slotId}": {
      "schema": { "$ref": "#/entities/Slot" },
      "description": "Stores available slots for a specific business."
    }
  }
}